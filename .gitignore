**/.DS_Store

# Training artifacts (model_shay). A run directory holds one ~350MB checkpoint
# per fold plus its metrics; the CLI creates it relative to wherever it was
# invoked, so this is deliberately unanchored and matches runs/ at any depth.
runs/
*.pt
*.pth

# transient artifacts: gdown partial downloads, editor lock files
*.part
.~lock.*#
