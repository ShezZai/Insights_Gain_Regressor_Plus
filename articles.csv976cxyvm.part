/chunks/1823-e7cd018d460c55f8.js\"",\""4334\"",\""static/chunks/4334-84a441a294158c59.js\"",\""4305\"",\""static/chunks/4305-5b75ff3e09e398d3.js\"",\""996\"",\""static/chunks/996-562f96a942b8ba45.js\"",\""1560\"",\""static/chunks/1560-200b96e6f89aa97f.js\"",\""1007\"",\""static/chunks/1007-492341b35d2ce6f6.js\"",\""5467\"",\""static/chunks/5467-a50e33b1b51745b7.js\"",\""313\"",\""static/chunks/313-a8830d0316e21e14.js\"",\""9856\"",\""static/chunks/9856-1c2c7c197497306e.js\"",\""3535\"",\""static/chunks/3535-d53887f52dac98b1.js\"",\""9630\"",\""static/chunks/9630-bfca021429fb980a.js\"",\""2883\"",\""static/chunks/2883-cb43bffd24f057c0.js\"",\""4684\"",\""static/chunks/4684-9e0672ad00452c83.js\"",\""6519\"",\""static/chunks/app/(site)/(chrome)/page-2bbdee60f44fa5a8.js\""],\""TickerSpan\""]\n""])</script><script>self.__next_f.push([1,""64:[\""$\"",\""div\"",null,{\""id\"":\""article-body\"",\""className\"":\""article-body\"",\""children\"":[[\""$\"",\""p\"",\""0\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":[\""Stocks in the quantum computing industry went all over the place in March. \"",[\""$\"",\""a\"",\""1\"",{\""href\"":\""http://marketintelligence.spglobal.com/\"",\""className\"":\""text-cyan-900 hover:text-cyan-800\"",\""target\"":\""_blank\"",\""rel\"":\""noopener noreferrer\"",\""style\"":\""$undefined\"",\""children\"":\""According to data from S\u0026P Global Market Intelligence\""}],\"", \"",[\""$\"",\""strong\"",\""3\"",{\""children\"":\""D-Wave Quantum\""}],\"" \"",[\""$\"",\""$L79\"",\""5\"",{\""symbol\"":\""QBTS\"",\""exchange\"":\""nyse\"",\""percentChange\"":6.57,\""instrumentId\"":451374}],\"" rose 38.7%, and \"",[\""$\"",\""strong\"",\""7\"",{\""children\"":\""Quantum Computing\""}],\"" \"",[\""$\"",\""$L79\"",\""9\"",{\""symbol\"":\""QUBT\"",\""exchange\"":\""nasdaq\"",\""percentChange\"":2.62,\""instrumentId\"":356047}],\"" gained 31.9%. At the same time, shares of \"",[\""$\"",\""strong\"",\""11\"",{\""children\"":\""Rigetti Computing\""}],\"" \"",[\""$\"",\""$L79\"",\""13\"",{\""symbol\"":\""RGTI\"",\""exchange\"":\""nasdaq\"",\""percentChange\"":4.01,\""instrumentId\"":415273}],\"" fell 6.4%, and \"",[\""$\"",\""strong\"",\""15\"",{\""children\"":\""IonQ\""}],\"" \"",[\""$\"",\""$L79\"",\""17\"",{\""symbol\"":\""IONQ\"",\""exchange\"":\""nyse\"",\""percentChange\"":2.4,\""instrumentId\"":369917}],\"" took a 10.2% price cut.\""]}],\""\\n\"",[\""$\"",\""p\"",\""2\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""It was a busy month, for sure:\""}],\""\\n\"",[\""$\"",\""ul\"",\""4\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":[\""\\n\"",[\""$\"",\""li\"",\""1\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""Three of these stocks reported earnings in March.\""}],\""\\n\"",[\""$\"",\""li\"",\""3\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""There was a high-profile industry conference with market-moving implications.\""}],\""\\n\"",[\""$\"",\""li\"",\""5\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""D-Wave announced an important achievement in its technology research.\""}],\""\\n\""]}],\""\\n\"",[\""$\"",\""h2\"",\""6\"",{\""id\"":\""$undefined\"",\""className\"":\""my-6 text-2xl font-bold\"",\""data-block-key\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""D-Wave's technical achievement versus weak financial reports\""}],\""\\n\"",[\""$\"",\""p\"",\""8\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""Let's start with the biggest gain. On March 12, D-Wave said it had applied its annealing quantum computing systems to solve \\\""a useful, real-world problem.\\\"" The company's PR department laid it on thick, citing a \\\""landmark\\\"" paper that \\\""unequivocally validates\\\"" this industry-first achievement.\""}],\""\\n\"",[\""$\"",\""$1\"",\""10\"",{\""children\"":[[\""$\"",\""p\"",null,{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""The company announced earnings the next day. Sales were flat year over year, and net losses under generally accepted accounting principles (GAAP) shrank from $0.60 to $0.15 per share.\""}],[\""$\"",\""div\"",null,{\""className\"":\""my-8 lg:hidden\"",\""children\"":[\""$\"",\""$L1d\"",null,{\""placement\"":\""foolcom_sidebar_top\"",\""containerId\"":\""foolcom_sidebar_top_mobile_container\"",\""children\"":[\""$\"",\""div\"",null,{\""className\"":\""min-h-[350px] rounded border border-gray-200 bg-white p-4 shadow-sm\"",\""children\"":[[\""$\"",\""div\"",null,{\""className\"":\""mb-3 h-4 w-2/3 rounded bg-gray-200\""}],[\""$\"",\""div\"",null,{\""className\"":\""mb-2 h-3 w-full rounded bg-gray-100\""}],[\""$\"",\""div\"",null,{\""className\"":\""h-3 w-5/6 rounded bg-gray-100\""}]]}]}]}]]}],\""\\n\"",[\""$\"",\""$1\"",\""12\"",{\""children\"":[[\""$\"",\""p\"",null,{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""Together with D-Wave's suddenly useful technology, investors embraced these results with open arms. The stock soared 92% in three days, pulling the rest of the industry along for a bullish ride.\""}],false]}],\""\\n\"",\""$L7a\"",\""\\n\"",[\""$\"",\""$1\"",\""16\"",{\""children\"":[[\""$\"",\""p\"",null,{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""By contrast, Rigetti and Quantum Computing posted quarterly results far below analyst expectations. Rigetti's fourth-quarter sales fell 33% year over year, multiplying the net losses from $0.09 to $0.68 per share. Quantum Computing posted 17% lower sales and 35% higher operating costs. Net losses increased from $0.09 to $0.47 per share in the fourth quarter. These reports didn't move Quantum Computing stock very far, though.\""}],[\""$\"",\""div\"",null,{\""children\"":[\""$\"",\""$L1d\"",null,{\""placement\"":\""in_line_article_pitch\"",\""children\"":[\""$\"",\""div\"",null,{\""className\"":\""my-32px p-40px relative mx-auto min-h-[660px] overflow-hidden rounded border border-gray-200 bg-gray-100 md:min-h-[300px]\"",\""children\"":[[\""$\"",\""div\"",null,{\""className\"":\""border-b-1px pb-16px border-dotted border-gray-300\"",\""children\"":\""$L7b\""}],\""$L7c\""]}]}]}]]}],\""\\n\"",\""$L7d\"",\""\\n\"",\""$L7e\"",\""\\n\"",\""$L7f\"",\""\\n\"",\""$L80\"",\""\\n\"",\""$L81\"",\""\\n\"",\""$L82\"",\""\\n\"",\""$L83\"",\""\\n\"",\""$L84\"",\""\\n\"",\""$L85\"",\""\\n\"",\""$L86\"",\""\\n\"",\""$L87\"",\""\\n\"",\""$L88\""]}]\n""])</script><script>self.__next_f.push([1,""7b:[\""$\"",\""div\"",null,{\""className\"":\""h-8 w-2/3 rounded bg-gray-200\""}]\n7c:[\""$\"",\""div\"",null,{\""className\"":\""mt-16px space-y-3\"",\""children\"":[[\""$\"",\""div\"",null,{\""className\"":\""h-6 w-full rounded bg-gray-200\""}],[\""$\"",\""div\"",null,{\""className\"":\""h-6 w-11/12 rounded bg-gray-200\""}],[\""$\"",\""div\"",null,{\""className\"":\""h-12 w-48 rounded bg-gray-300\""}]]}]\n""])</script><script>self.__next_f.push([1,""7d:[\""$\"",\""p\"",\""18\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":[[\""$\"",\""strong\"",\""0\"",{\""children\"":\""Nvidia\""}],\"" stole the thunder of Quantum Computing's report by hosting a \\\""quantum day\\\"" at the GTC technology conference at the same time. CEO Jensen Huang used that stage to \"",[\""$\"",\""a\"",\""2\"",{\""href\"":\""https://www.fool.com/investing/2025/03/27/why-ionq-stock-soared-this-week/\"",\""className\"":\""text-cyan-900 hover:text-cyan-800\"",\""target\"":\""$undefined\"",\""rel\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""apologize\""}],\"" for his earlier analysis of the quantum computing industry placing real-world usage \"",[\""$\"",\""a\"",\""4\"",{\""href\"":\""https://www.fool.com/investing/2025/01/09/nvidia-ceo-jensen-huang-just-delivered-terrible-ne/\"",\""className\"":\""text-cyan-900 hover:text-cyan-800\"",\""target\"":\""$undefined\"",\""rel\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""roughly 20 years into the future\""}],\"".\""]}]\n""])</script><script>self.__next_f.push([1,""7e:[\""$\"",\""$1\"",\""20\"",{\""children\"":[[\""$\"",\""p\"",null,{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""Investors didn't really buy that apology, resulting in unusually high volatility among quantum stocks on March 20.\""}],[\""$\"",\""div\"",null,{\""className\"":\""my-8\"",\""children\"":[\""$\"",\""div\"",null,{\""className\"":\""relative w-full overflow-hidden rounded-lg bg-gray-100\"",\""children\"":[\""$\"",\""div\"",null,{\""className\"":\""relative\"",\""style\"":{\""paddingBottom\"":\""56.25%\""},\""children\"":[\""$\"",\""iframe\"",null,{\""className\"":\""absolute top-0 left-0 h-full w-full\"",\""src\"":\""https://www.youtube-nocookie.com/embed/tDZfdp_V6CU\"",\""title\"":\""D-Wave CEO Alan Baratz on the Path to Profitable Quantum Computing | QBTS Interview\"",\""frameBorder\"":\""0\"",\""allow\"":\""accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture\"",\""allowFullScreen\"":true}]}]}]}]]}]\n""])</script><script>self.__next_f.push([1,""80:[\""$\"",\""h2\"",\""24\"",{\""id\"":\""$undefined\"",\""className\"":\""my-6 text-2xl font-bold\"",\""data-block-key\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""This industry has a long (and time-consuming) way to go\""}]\n81:[\""$\"",\""$1\"",\""26\"",{\""children\"":[[\""$\"",\""p\"",null,{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":[\""D-Wave's \\\""quantum supremacy\\\"" moment might have lifted the whole sector in March, like \"",[\""$\"",\""strong\"",\""1\"",{\""children\"":\""Alphabet's\""}],\"" error-correcting progress that boosted this sector in November 2024. But the quality of that achievement quickly came under fire, as \"",[\""$\"",\""em\"",\""3\"",{\""children\"":\""Scientific American\""}],\"" noted that researchers had essentially refuted D-Wave's research paper in March 2024, during the peer-review process.\""]}],false]}]\n82:[\""$\"",\""p\"",\""28\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""The quantum simulation of magnetic materials would reportedly take millions of years on a digital computer, but a new algorithm did the job on a normal laptop in two hours.\""}]\n83:[\""$\"",\""p\"",\""30\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""So it wasn't surprising to see the earlier price gains fade out to some degree. Still, the pure-play quantum computing stocks are floating on high hopes right now. All four of those pure-play quantum computing experts under my lens have at least tripled in the last six months. The gains of sector leader IonQ are less speculative than those of its smaller and riskier peers, but it's still a big jump based on more PR spin than actual progress:\""}]\n84:[\""$\"",\""p\"",\""32\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":[\""$\"",\""a\"",null,{\""href\"":\""https://ycharts.com/companies/QUBT/chart/\"",\""className\"":\""text-cyan-900 hover:text-cyan-800\"",\""target\"":\""_blank\"",\""rel\"":\""noopener noreferrer\"",\""style\"":\""$undefined\"",\""children\"":[\""$\"",\""$L39\"",null,{\""src\"":\""https://media.ycharts.com/charts/e8329932171fb11e87e3fe41229d5d5a.png\"",\""alt\"":\""QUBT Chart\"",\""width\"":720,\""height\"":380,\""sizes\"":\""(max-width: 768px) 100vw, 720px\"",\""className\"":\""h-auto max-w-full rounded object-contain\"",\""style\"":{\""""])</script><script>self.__next_f.push([1,""maxWidth\"":\""720px\""},\""decoding\"":\""async\"",\""priority\"":true,\""fetchPriority\"":\""high\""}]}]}]\n85:[\""$\"",\""p\"",\""34\"",{\""className\"":\""caption\"",\""children\"":[[\""$\"",\""a\"",\""0\"",{\""href\"":\""https://ycharts.com/companies/QUBT\"",\""className\"":\""text-cyan-900 hover:text-cyan-800\"",\""target\"":\""_blank\"",\""rel\"":\""noopener noreferrer\"",\""style\"":\""$undefined\"",\""children\"":\""QUBT\""}],\"" data by \"",[\""$\"",\""a\"",\""2\"",{\""href\"":\""https://ycharts.com\"",\""className\"":\""text-cyan-900 hover:text-cyan-800\"",\""target\"":\""_blank\"",\""rel\"":\""noopener noreferrer\"",\""style\"":\""$undefined\"",\""children\"":\""YCharts.\""}]]}]\n86:[\""$\"",\""p\"",\""36\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":[\""Long story short, the quantum computing space has been overheated since \"",[\""$\"",\""a\"",\""1\"",{\""href\"":\""https://www.fool.com/investing/2024/12/24/googles-quantum-chip/\"",\""className\"":\""text-cyan-900 hover:text-cyan-800\"",\""target\"":\""$undefined\"",\""rel\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""Alphabet's Willow announcement\""}],\"". The stocks in this field should continue to trend lower as this speculative trend cools off.\""]}]\n87:[\""$\"",\""$1\"",\""38\"",{\""children\"":[[\""$\"",\""p\"",null,{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""Quantum computing will probably disrupt many industries and change how you think about computers in the long run, but it's much too early to pick long-term winners in this race. Please keep your pure-play quantum computing investments small enough that you could stand them going to zero.\""}],false]}]\n88:[\""$\"",\""p\"",\""40\"",{\""className\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":[\""Alternatively, you might want to lean on true tech giants like Alphabet and Nvidia instead. Almost every name in \"",[\""$\"",\""a\"",\""1\"",{\""href\"":\""https://www.fool.com/investing/how-to-invest/stocks/magnificent-seven/\"",\""className\"":\""text-cyan-900 hover:text-cyan-800\"",\""target\"":\""$undefined\"",\""rel\"":\""$undefined\"",\""style\"":\""$undefined\"",\""children\"":\""the \\\""Magnificent Seven\\\"" club\""}],\"" is deeply invested in quantum computing research. This way, you get exposure to the opportunity -- as a side dish to a trillion-dollar tech titan's world-class business.\""]}]\n""])</script><script>self.__next_f.push([1,""89:I[5985,[\""2619\"",\""static/chunks/2619-cc500190e8a1fb7b.js\"",\""8347\"",\""static/chunks/8347-cacdc1e2326c096c.js\"",\""4909\"",\""static/chunks/4909-749b8018a6187820.js\"",\""1356\"",\""static/chunks/1356-5d2292f4c77a8e97.js\"",\""278\"",\""static/chunks/278-59961bd6978ce8e6.js\"",\""5106\"",\""static/chunks/5106-3c2db5a1cd76463c.js\"",\""5376\"",\""static/chunks/5376-4d8b64e1cd73cc04.js\"",\""7520\"",\""static/chunks/7520-7211882c979af373.js\"",\""5249\"",\""static/chunks/5249-d3abf0741a105389.js\"",\""8751\"",\""static/chunks/8751-8de1d0f58d3d3996.js\"",\""4257\"",\""static/chunks/4257-a7ebdc261f671b63.js\"",\""1085\"",\""static/chunks/1085-7a80920c10ccc289.js\"",\""818\"",\""static/chunks/818-14fa386bb2023f54.js\"",\""7295\"",\""static/chunks/7295-b703b2ce48091a34.js\"",\""1823\"",\""static/chunks/1823-e7cd018d460c55f8.js\"",\""4334\"",\""static/chunks/4334-84a441a294158c59.js\"",\""4305\"",\""static/chunks/4305-5b75ff3e09e398d3.js\"",\""996\"",\""static/chunks/996-562f96a942b8ba45.js\"",\""1560\"",\""static/chunks/1560-200b96e6f89aa97f.js\"",\""1007\"",\""static/chunks/1007-492341b35d2ce6f6.js\"",\""5467\"",\""static/chunks/5467-a50e33b1b51745b7.js\"",\""313\"",\""static/chunks/313-a8830d0316e21e14.js\"",\""9856\"",\""static/chunks/9856-1c2c7c197497306e.js\"",\""3535\"",\""static/chunks/3535-d53887f52dac98b1.js\"",\""9630\"",\""static/chunks/9630-bfca021429fb980a.js\"",\""2883\"",\""static/chunks/2883-cb43bffd24f057c0.js\"",\""4684\"",\""static/chunks/4684-9e0672ad00452c83.js\"",\""6519\"",\""static/chunks/app/(site)/(chrome)/page-2bbdee60f44fa5a8.js\""],\""CompanyCardClient\""]\n""])</script><script>self.__next_f.push([1,""7a:[\""$\"",\""$L89\"",\""14\"",{\""companyData\"":{\""name\"":\""IonQ