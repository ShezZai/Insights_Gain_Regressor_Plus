\""datePublished\"":\""2025-04-02T16:52:36.000Z\"",\""dateModified\"":\""2025-04-02T16:52:36.000Z\"",\""author\"":{\""@type\"":\""Person\"",\""name\"":\""Anders Bylund\"",\""url\"":\""https://www.fool.com/author/1484/\"",\""jobTitle\"":\""Contributing Analyst\"",\""description\"":\""Anders Bylund is a contributing Motley Fool media and technology analyst covering semiconductors, cloud computing, internet infrastructure, quantum computing, and streaming media. Anders holds a bachelor’s degree in English and a master’s degree in library and information sciences from Florida State University. He believes in coyotes and time as an abstract.\"",\""sameAs\"":[\""https://www.linkedin.com/in/andersbylund/\"",\""https://twitter.com/TMFZahrim\""],\""image\"":{\""@type\"":\""ImageObject\"",\""url\"":\""https://g.foolcdn.com/avatar/189184737/large.ashx\"",\""height\"":\""80\"",\""width\"":\""80\""}},\""about\"":[{\""@type\"":\""Corporation\"",\""tickerSymbol\"":\""NASDAQ QBTS\""},{\""@type\"":\""Corporation\"",\""tickerSymbol\"":\""NASDAQ GOOGL\""},{\""@type\"":\""Corporation\"",\""tickerSymbol\"":\""NASDAQ NVDA\""},{\""@type\"":\""Corporation\"",\""tickerSymbol\"":\""NASDAQ GOOG\""},{\""@type\"":\""Corporation\"",\""tickerSymbol\"":\""NYSE IONQ\""},{\""@type\"":\""Corporation\"",\""tickerSymbol\"":\""NASDAQ QUBT\""},{\""@type\"":\""Corporation\"",\""tickerSymbol\"":\""NASDAQ RGTI\""}],\""publisher\"":{\""@type\"":\""Organization\"",\""@id\"":\""https://www.fool.com/\"",\""name\"":\""The Motley Fool\"",\""url\"":\""https://www.fool.com/\"",\""logo\"":{\""@type\"":\""ImageObject\"",\""url\"":\""https://g.foolcdn.com/misc-assets/logo-tmf-primary-7-magenta-royalpurple.svg\"",\""width\"":\""157\"",\""height\"":\""43\""},\""brand\"":\""The Motley Fool\"",\""contactPoint\"":{\""@type\"":\""ContactPoint\"",\""contactType\"":\""Media Inquiries\"",\""email\"":\""pr@fool.com\""},\""publishingPrinciples\"":\""https://www.fool.com/about/\"",\""sameAs\"":[\""https://www.fool.com/about/\"",\""https://en.wikipedia.org/wiki/The_Motley_Fool\"",\""https://www.wikidata.org/wiki/Q7752442\"",\""https://www.linkedin.com/company/the-motley-fool\"",\""https://www.facebook.com/themotleyfool/\"",\""https://x.com/themotleyfool\"",\""https://www.instagram.com/themotleyfoolofficial/\"",\""https://www.youtube.com/channel/UCpRQuynBX9Qy9tPrcswpPag\"",\""https://www.pinterest.com/themotleyfool/\"",\""https://www.tiktok.com/@themotleyfoolofficial\"",\""https://www.google.com/search?kgmid=/m/0578mk\""]},\""description\"":\""Quantum computing stocks went in different directions last month. See what it means for your investment strategy in this red-hot computing field.\"",\""image\"":{\""@type\"":\""ImageObject\"",\""url\"":\""https://g.foolcdn.com/editorial/images/813428/quantum-computing-quibit-chip.jpg\"",\""height\"":\""630\"",\""width\"":\""1200\""}}""])</script><script>self.__next_f.push([1,""3e:[[\""$\"",\""script\"",null,{\""id\"":\""article-jsonld\"",\""type\"":\""application/ld+json\"",\""dangerouslySetInnerHTML\"":{\""__html\"":\""$56\""}}],null,\""$L57\""]\n""])</script><script>self.__next_f.push([1,""58:I[20699,[\""2619\"",\""static/chunks/2619-cc500190e8a1fb7b.js\"",\""8347\"",\""static/chunks/8347-cacdc1e2326c096c.js\"",\""6180\"",\""static/chunks/6180-a11874dcfed6d974.js\"",\""4909\"",\""static/chunks/4909-749b8018a6187820.js\"",\""1356\"",\""static/chunks/1356-5d2292f4c77a8e97.js\"",\""278\"",\""static/chunks/278-59961bd6978ce8e6.js\"",\""5106\"",\""static/chunks/5106-3c2db5a1cd76463c.js\"",\""5376\"",\""static/chunks/5376-4d8b64e1cd73cc04.js\"",\""7520\"",\""static/chunks/7520-7211882c979af373.js\"",\""5249\"",\""static/chunks/5249-d3abf0741a105389.js\"",\""8751\"",\""static/chunks/8751-8de1d0f58d3d3996.js\"",\""4257\"",\""static/chunks/4257-a7ebdc261f671b63.js\"",\""1085\"",\""static/chunks/1085-7a80920c10ccc289.js\"",\""818\"",\""static/chunks/818-14fa386bb2023f54.js\"",\""7295\"",\""static/chunks/7295-b703b2ce48091a34.js\"",\""1823\"",\""static/chunks/18